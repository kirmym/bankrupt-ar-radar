# ─── App ────────────────────────────────────────────────────────────────────
app_env=development
log_level=INFO

# ─── Database ────────────────────────────────────────────────────────────────
database_url=postgresql+asyncpg://postgres:postgres@postgres:5432/ar_radar
sync_database_url=postgresql://postgres:postgres@postgres:5432/ar_radar

# ─── Redis ───────────────────────────────────────────────────────────────────
redis_url=redis://redis:6379/0

# ─── Telegram ────────────────────────────────────────────────────────────────
telegram_bot_token=
telegram_chat_ids=

# ─── ЕФРСБ (получите токен после договора) ────────────────────────────────────
efrsb_api_token=
efrsb_api_url=https://bank-publications.fedresurs.ru

# ─── LLM (этап 2) ─────────────────────────────────────────────────────────────
openai_api_key=
llm_model=gpt-4o-mini
llm_temperature=0.0

# ─── Scoring defaults ────────────────────────────────────────────────────────
default_discount_a=0.85
default_discount_b=0.65
default_discount_c=0.35
default_discount_d=0.05
cost_court_rub=150000
cost_enforcement_rub=80000
cost_bankruptcy_rub=300000
alternative_rate=0.20

# ─── Интервалы (минуты) ──────────────────────────────────────────────────────
ingest_interval_minutes=15
enrich_interval_minutes=60
score_interval_minutes=30
