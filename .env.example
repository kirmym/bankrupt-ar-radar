# ─── App ────────────────────────────────────────────────────────────────────
app_env=development
log_level=INFO
# Воркеры и алерты внутри API-процесса (Railway-режим)
enable_workers=true
# Интерактивный aiogram-бот (/top) — отдельный сервис bot/, здесь выключен
enable_bot=false
# Папка собранного фронтенда (в Docker: /app/web/dist)
web_dist_dir=
# Секрет для X-API-Key на приватных endpoint-ах. В production задать через secret store.
api_auth_token=

# ─── Database ────────────────────────────────────────────────────────────────
# Railway отдаёт postgres:// — код сам приводит к postgresql+asyncpg://
database_url=postgresql://postgres:postgres@postgres:5432/ar_radar

# ─── Telegram ────────────────────────────────────────────────────────────────
telegram_bot_token=
telegram_chat_ids=
telegram_allowed_user_ids=

# ─── ЕФРСБ: разрешённый публичный HTML-парсер ────────────────────────────────
efrsb_api_token=
efrsb_api_url=https://bank-publications.fedresurs.ru
efrsb_public_url=https://bankrot.fedresurs.ru
# Optional: CDP endpoint of a running CloakBrowser profile for 401/403/429 fallback.
# The challenge is completed manually in the browser; no automatic CAPTCHA solving.
cloakbrowser_cdp_url=
cloakbrowser_timeout_seconds=90
cloakbrowser_wait_seconds=8
ingest_max_pages=10
ingest_page_size=50
# Только источники с подтверждённым бесплатным API, например: fssp.
# Пусто отключает API-вызовы; для остальных источников используется парсинг.
free_api_sources=

# ─── LLM (этап 2) ─────────────────────────────────────────────────────────────
openai_api_key=
llm_model=gpt-4o-mini
llm_temperature=0.0

# ─── Scoring defaults ────────────────────────────────────────────────────────
default_discount_a=0.85
default_discount_b=0.65
default_discount_c=0.35
default_discount_d=0.05
cost_court_rub=150000
cost_enforcement_rub=80000
cost_bankruptcy_rub=300000
alternative_rate=0.20

# ─── Интервалы (минуты) ──────────────────────────────────────────────────────
ingest_interval_minutes=15
enrich_interval_minutes=60
score_interval_minutes=30
alert_interval_minutes=30
